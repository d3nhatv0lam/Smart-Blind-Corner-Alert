  {
    "id": "fn_create_tables_sql",
    "type": "function",
    "z": "tab_blind_corner_v5",
    "name": "SQL Tạo Bảng & Khởi tạo Giờ",
    "func": "msg.topic = `\nCREATE TABLE IF NOT EXISTS motion_events (\n    id INTEGER PRIMARY KEY AUTOINCREMENT,\n    device_id TEXT NOT NULL,\n    direction TEXT NOT NULL,\n    event_type TEXT NOT NULL,\n    device_timestamp INTEGER,\n    created_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\nCREATE TABLE IF NOT EXISTS device_status (\n    device_id TEXT PRIMARY KEY,\n    is_online INTEGER DEFAULT 0,\n    last_heartbeat DATETIME,\n    left_active INTEGER DEFAULT 0,\n    right_active INTEGER DEFAULT 0,\n    led_left_active INTEGER DEFAULT 0,\n    led_right_active INTEGER DEFAULT 0,\n    left_detections INTEGER DEFAULT 0,\n    right_detections INTEGER DEFAULT 0,\n    uptime INTEGER DEFAULT 0,\n    firmware_version TEXT,\n    updated_at DATETIME DEFAULT CURRENT_TIMESTAMP\n);\nINSERT OR IGNORE INTO device_status (device_id, is_online, firmware_version) VALUES ('blind-corner-001', 0, '1.0.0');\n`;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 400,
    "y": 60,
    "wires": [
      [
        "sqlite_exec_init"
      ]
    ]
  },
