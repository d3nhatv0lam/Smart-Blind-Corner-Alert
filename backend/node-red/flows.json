  {
    "id": "ui_template_linechart",
    "type": "ui-template",
    "z": "tab_blind_corner_v5",
    "group": "grp_chart_v5",
    "name": "Biểu Đồ Đường Giờ Cao Điểm",
    "order": 1,
    "width": "5",
    "height": "8",
    "format": "<template>\n  <div class=\"linechart-card\">\n    <!-- Header & Phân tích Giờ Cao Điểm -->\n    <div class=\"chart-header\">\n      <div>\n        <div class=\"chart-title\">📈 BIỂU ĐỒ LƯU LƯỢNG THEO GIỜ</div>\n        <div class=\"peak-badge\">\n          🔥 Cao điểm nhất: <b>{{ peakHour.time }}</b> ({{ peakHour.total }} xe/h)\n        </div>\n      </div>\n    </div>\n\n    <!-- Chú thích 2 đường -->\n    <div class=\"chart-legend\">\n      <span class=\"legend-item\"><span class=\"dot blue\"></span> Xe Trái ({{ currentLeft }} xe)</span>\n      <span class=\"legend-item\"><span class=\"dot orange\"></span> Xe Phải ({{ currentRight }} xe)</span>\n    </div>\n\n    <!-- Bản vẽ Biểu Đồ Đường SVG (Line Chart) -->\n    <svg viewBox=\"0 0 340 210\" class=\"chart-svg\">\n      <!-- Lưới ngang Y và nhãn số lượng xe -->\n      <line x1=\"35\" y1=\"20\" x2=\"325\" y2=\"20\" stroke=\"#334155\" stroke-dasharray=\"3,3\" stroke-width=\"1\"/>\n      <text x=\"28\" y=\"24\" fill=\"#64748b\" font-size=\"9\" text-anchor=\"end\">{{ maxVal }}</text>\n\n      <line x1=\"35\" y1=\"60\" x2=\"325\" y2=\"60\" stroke=\"#334155\" stroke-dasharray=\"3,3\" stroke-width=\"1\"/>\n      <text x=\"28\" y=\"64\" fill=\"#64748b\" font-size=\"9\" text-anchor=\"end\">{{ Math.round(maxVal * 0.66) }}</text>\n\n      <line x1=\"35\" y1=\"100\" x2=\"325\" y2=\"100\" stroke=\"#334155\" stroke-dasharray=\"3,3\" stroke-width=\"1\"/>\n      <text x=\"28\" y=\"104\" fill=\"#64748b\" font-size=\"9\" text-anchor=\"end\">{{ Math.round(maxVal * 0.33) }}</text>\n\n      <!-- Trục hoành X = 0 -->\n      <line x1=\"35\" y1=\"140\" x2=\"325\" y2=\"140\" stroke=\"#475569\" stroke-width=\"1.5\"/>\n      <text x=\"28\" y=\"144\" fill=\"#64748b\" font-size=\"9\" text-anchor=\"end\">0</text>\n\n      <!-- Tô màu diện tích mờ dưới đường cong (Area fill) -->\n      <polygon :points=\"areaPointsLeft\" fill=\"url(#gradAreaBlue)\" opacity=\"0.2\"/>\n      <polygon :points=\"areaPointsRight\" fill=\"url(#gradAreaOrange)\" opacity=\"0.2\"/>\n\n      <!-- ĐƯỜNG CONG XE HƯỚNG TRÁI (MÀU XANH LAM) -->\n      <polyline :points=\"linePointsLeft\" fill=\"none\" stroke=\"#38bdf8\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <!-- Các điểm tròn trên đường xanh -->\n      <circle v-for=\"(p, i) in pointsLeft\" :key=\"'l'+i\" :cx=\"p.x\" :cy=\"p.y\" r=\"4\" fill=\"#0284c7\" stroke=\"#38bdf8\" stroke-width=\"2\"/>\n\n      <!-- ĐƯỜNG CONG XE HƯỚNG PHẢI (MÀU CAM) -->\n      <polyline :points=\"linePointsRight\" fill=\"none\" stroke=\"#fb923c\" stroke-width=\"3\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/>\n      <!-- Các điểm tròn trên đường cam -->\n      <circle v-for=\"(p, i) in pointsRight\" :key=\"'r'+i\" :cx=\"p.x\" :cy=\"p.y\" r=\"4\" fill=\"#ea580c\" stroke=\"#fb923c\" stroke-width=\"2\"/>\n\n      <!-- Nhãn các mốc giờ trên trục hoành X (16:00, 17:00...) -->\n      <text v-for=\"(item, i) in pointsLeft\" :key=\"'t'+i\" :x=\"item.x\" y=\"158\" fill=\"#94a3b8\" font-size=\"9\" font-weight=\"bold\" text-anchor=\"middle\">\n        {{ traffic[i].time }}\n      </text>\n\n      <defs>\n        <linearGradient id=\"gradAreaBlue\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#38bdf8\" stop-opacity=\"0.6\"/>\n          <stop offset=\"100%\" stop-color=\"#38bdf8\" stop-opacity=\"0\"/>\n        </linearGradient>\n        <linearGradient id=\"gradAreaOrange\" x1=\"0%\" y1=\"0%\" x2=\"0%\" y2=\"100%\">\n          <stop offset=\"0%\" stop-color=\"#fb923c\" stop-opacity=\"0.6\"/>\n          <stop offset=\"100%\" stop-color=\"#fb923c\" stop-opacity=\"0\"/>\n        </linearGradient>\n      </defs>\n    </svg>\n\n    <!-- Thanh cảnh báo mật độ -->\n    <div class=\"trend-footer\">\n      <span>🚦 Trạng thái hiện tại: <b :style=\"{ color: densityColor }\">{{ densityStatus }}</b></span>\n      <span>Tổng ngày: <b>{{ totalDay }}</b> lượt</span>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      traffic: [\n        { time: \"16:00\", left: 4, right: 3 },\n        { time: \"17:00\", left: 9, right: 11 },\n        { time: \"18:00\", left: 16, right: 24 }, // Đỉnh cao điểm mẫu\n        { time: \"19:00\", left: 12, right: 18 },\n        { time: \"20:00\", left: 7, right: 14 },\n        { time: \"21:00\", left: 6, right: 12 },\n        { time: \"22:00\", left: 8, right: 21 }\n      ]\n    }\n  },\n  computed: {\n    maxVal() {\n      let m = 20;\n      this.traffic.forEach(d => {\n        if (d.left > m) m = d.left;\n        if (d.right > m) m = d.right;\n      });\n      return Math.ceil(m / 5) * 5;\n    },\n    pointsLeft() {\n      const startX = 50;\n      const endX = 310;\n      const stepX = (endX - startX) / (this.traffic.length - 1);\n      return this.traffic.map((d, i) => ({\n        x: Math.round(startX + i * stepX),\n        y: Math.round(140 - (d.left / this.maxVal) * 120)\n      }));\n    },\n    pointsRight() {\n      const startX = 50;\n      const endX = 310;\n      const stepX = (endX - startX) / (this.traffic.length - 1);\n      return this.traffic.map((d, i) => ({\n        x: Math.round(startX + i * stepX),\n        y: Math.round(140 - (d.right / this.maxVal) * 120)\n      }));\n    },\n    linePointsLeft() {\n      return this.pointsLeft.map(p => `${p.x},${p.y}`).join(\" \");\n    },\n    linePointsRight() {\n      return this.pointsRight.map(p => `${p.x},${p.y}`).join(\" \");\n    },\n    areaPointsLeft() {\n      if (!this.pointsLeft.length) return \"\";\n      const first = this.pointsLeft[0];\n      const last = this.pointsLeft[this.pointsLeft.length - 1];\n      return `${first.x},140 ` + this.linePointsLeft + ` ${last.x},140`;\n    },\n    areaPointsRight() {\n      if (!this.pointsRight.length) return \"\";\n      const first = this.pointsRight[0];\n      const last = this.pointsRight[this.pointsRight.length - 1];\n      return `${first.x},140 ` + this.linePointsRight + ` ${last.x},140`;\n    },\n    peakHour() {\n      let maxT = 0;\n      let peak = { time: \"18:00\", total: 40 };\n      this.traffic.forEach(d => {\n        const t = d.left + d.right;\n        if (t > maxT) {\n          maxT = t;\n          peak = { time: d.time, total: t };\n        }\n      });\n      return peak;\n    },\n    currentLeft() {\n      return this.traffic[this.traffic.length - 1].left;\n    },\n    currentRight() {\n      return this.traffic[this.traffic.length - 1].right;\n    },\n    totalDay() {\n      return this.traffic.reduce((acc, d) => acc + d.left + d.right, 0);\n    },\n    densityStatus() {\n      const cur = this.currentLeft + this.currentRight;\n      if (cur > 30) return \"MẬT ĐỘ RẤT CAO\";\n      if (cur > 15) return \"MẬT ĐỘ VỪA PHẢI\";\n      return \"MẬT ĐỘ THẤP\";\n    },\n    densityColor() {\n      const cur = this.currentLeft + this.currentRight;\n      if (cur > 30) return \"#ef4444\";\n      if (cur > 15) return \"#f59e0b\";\n      return \"#10b981\";\n    }\n  },\n  watch: {\n    msg: function(newVal) {\n      if (newVal && newVal.payload && Array.isArray(newVal.payload)) {\n        this.traffic = newVal.payload;\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.linechart-card {\n  background: #0f172a;\n  border-radius: 10px;\n  padding: 12px;\n  border: 1px solid #334155;\n  box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n  height: 100%;\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n}\n.chart-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n}\n.chart-title {\n  font-weight: 800;\n  color: #38bdf8;\n  font-size: 13px;\n  letter-spacing: 0.5px;\n}\n.peak-badge {\n  display: inline-block;\n  background: rgba(239, 68, 68, 0.2);\n  color: #f87171;\n  border: 1px solid #ef4444;\n  padding: 2px 8px;\n  border-radius: 12px;\n  font-size: 11px;\n  font-weight: bold;\n  margin-top: 3px;\n}\n.chart-legend {\n  display: flex;\n  gap: 15px;\n  font-size: 11px;\n  margin: 6px 0;\n}\n.legend-item {\n  display: flex;\n  align-items: center;\n  gap: 5px;\n  color: #cbd5e1;\n}\n.dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n}\n.dot.blue { background: #38bdf8; box-shadow: 0 0 6px #38bdf8; }\n.dot.orange { background: #fb923c; box-shadow: 0 0 6px #fb923c; }\n.chart-svg {\n  width: 100%;\n  height: auto;\n}\n.trend-footer {\n  display: flex;\n  justify-content: space-between;\n  font-size: 11px;\n  background: #1e293b;\n  padding: 6px 10px;\n  border-radius: 6px;\n  border: 1px solid #334155;\n  color: #94a3b8;\n}\n.trend-footer b {\n  color: #f8fafc;\n}\n</style>",
    "storeOutMessages": true,
    "passthru": true,
    "resendOnRefresh": true,
    "templateScope": "local",
