  {
    "id": "fn_process_heartbeat",
    "type": "function",
    "z": "tab_blind_corner_v5",
    "name": "Xử lý Heartbeat, Watchdog & Chart",
    "func": "const p = msg.payload || {};\nconst deviceId = p.deviceId || 'blind-corner-001';\nconst isLeft = !!p.left;\nconst isRight = !!p.right;\nconst ledLeft = !!p.ledLeft;\nconst ledRight = !!p.ledRight;\nconst leftCount = p.leftDetections || 0;\nconst rightCount = p.rightDetections || 0;\nconst uptime = p.uptime || 0;\nconst version = p.firmwareVersion || '1.0.0';\n\nflow.set('left_count', leftCount);\nflow.set('right_count', rightCount);\n\n// 1. Cập nhật SQLite\nconst sqlMsg = {\n    topic: `UPDATE device_status SET is_online = 1, last_heartbeat = CURRENT_TIMESTAMP, left_active = ?, right_active = ?, led_left_active = ?, led_right_active = ?, left_detections = ?, right_detections = ?, uptime = ?, firmware_version = ?, updated_at = CURRENT_TIMESTAMP WHERE device_id = ?;`,\n    params: [isLeft?1:0, isRight?1:0, ledLeft?1:0, ledRight?1:0, leftCount, rightCount, uptime, version, deviceId]\n};\n\n// 2. Watchdog feed\nconst watchdogMsg = { payload: \"RESET_WATCHDOG\" };\n\n// 3. UI KPI Status\nconst uiStatusMsg = { payload: \"ONLINE 🟢 (\" + Math.floor(uptime/60) + \"p)\" };\nconst uiLeftCountMsg = { payload: leftCount };\nconst uiRightCountMsg = { payload: rightCount };\n\n// 4. Đồng bộ Biểu Đồ Đường Giờ Cao Điểm\nlet hourly = flow.get('hourly_traffic');\nif (!hourly) {\n    hourly = [\n        { time: \"16:00\", left: 4, right: 3 },\n        { time: \"17:00\", left: 9, right: 11 },\n        { time: \"18:00\", left: 16, right: 24 },\n        { time: \"19:00\", left: 12, right: 18 },\n        { time: \"20:00\", left: 7, right: 14 },\n        { time: \"21:00\", left: 6, right: 12 },\n        { time: \"22:00\", left: leftCount, right: rightCount }\n    ];\n} else {\n    hourly[hourly.length - 1].left = leftCount;\n    hourly[hourly.length - 1].right = rightCount;\n}\nflow.set('hourly_traffic', hourly);\n\nconst lineChartMsg = { payload: hourly };\n\nreturn [\n    sqlMsg, \n    watchdogMsg, \n    uiStatusMsg, \n    uiLeftCountMsg, \n    uiRightCountMsg, \n    lineChartMsg\n];",
    "outputs": 6,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
