  {
    "id": "fn_process_event",
    "type": "function",
    "z": "tab_blind_corner_v5",
    "name": "Xử lý Event & Dữ Liệu Đường Giờ Cao Điểm",
    "func": "const payload = msg.payload || {};\nconst deviceId   = payload.deviceId  || 'blind-corner-001';\nconst direction  = payload.direction  || 'UNKNOWN';\nconst eventType  = payload.eventType  || 'MOTION_DETECTED';\nconst timestamp  = payload.timestamp  || Math.floor(Date.now() / 1000);\n\n// 1. Ghi nhận sự kiện vào SQLite\nconst sqlMsg = {\n    topic: `INSERT INTO motion_events (device_id, direction, event_type, device_timestamp) VALUES (?, ?, ?, ?) ;`,\n    params: [deviceId, direction, eventType, timestamp]\n};\n\n// 2. Cập nhật Bảng Lịch Sử\nlet events = flow.get('recent_events') || [];\nconst timeStr = new Date().toLocaleTimeString('vi-VN');\nevents.unshift({\n    \"time\": timeStr,\n    \"device\": deviceId,\n    \"direction\": direction === 'LEFT' ? '⬅ XE TRÁI' : '➡ XE PHẢI',\n    \"event\": eventType\n});\nif (events.length > 20) events.pop();\nflow.set('recent_events', events);\nconst uiTableMsg = { payload: events };\n\n// 3. Tính toán nguy cơ va chạm đồng thời\nlet simCount = flow.get('simultaneous_count') || 0;\nconst lastLeftTime  = flow.get('last_left_time')  || 0;\nconst lastRightTime = flow.get('last_right_time') || 0;\nconst nowMs = Date.now();\nlet isCollisionRisk = false;\n\nif (direction === 'LEFT') {\n    flow.set('last_left_time', nowMs);\n    if (nowMs - lastRightTime < 2500) {\n        simCount++;\n        isCollisionRisk = true;\n        flow.set('simultaneous_count', simCount);\n    }\n} else if (direction === 'RIGHT') {\n    flow.set('last_right_time', nowMs);\n    if (nowMs - lastLeftTime < 2500) {\n        simCount++;\n        isCollisionRisk = true;\n        flow.set('simultaneous_count', simCount);\n    }\n}\nconst uiSimMsg = { payload: simCount };\n\n// 4. Cập nhật số đếm xe & Trực quan hóa 2 đèn cùng sáng khi va chạm\nlet leftCount  = flow.get('left_count')  || 0;\nlet rightCount = flow.get('right_count') || 0;\n\nif (direction === 'LEFT') {\n    leftCount++;\n    flow.set('left_count', leftCount);\n} else if (direction === 'RIGHT') {\n    rightCount++;\n    flow.set('right_count', rightCount);\n}\n\n// Kiểm tra cả 2 xe trong cửa sổ 2.5 giây (nếu cả 2 cùng tới -> CẢ 2 ĐÈN CÙNG SÁNG)\nconst isLeftActive  = (nowMs - (flow.get('last_left_time')  || 0) < 2500);\nconst isRightActive = (nowMs - (flow.get('last_right_time') || 0) < 2500);\n\nconst simVisualMsg = {\n    payload: {\n        isLeft:          isLeftActive,\n        isRight:         isRightActive,\n        isLedRight:      isLeftActive,   // Xe Trái tới -> Đèn Đỏ bên phải bật\n        isLedLeft:       isRightActive,  // Xe Phải tới -> Đèn Xanh bên trái bật\n        isCollisionRisk: (isLeftActive && isRightActive)\n    }\n};\n\nconst uiLeftCountMsg  = { payload: leftCount };\nconst uiRightCountMsg = { payload: rightCount };\n\n// 5. Cập nhật Lịch sử Lưu lượng theo Giờ phục vụ Biểu Đồ Đường\nlet hourly = flow.get('hourly_traffic');\nif (!hourly) {\n    hourly = [\n        { time: \"16:00\", left: 4,  right: 3  },\n        { time: \"17:00\", left: 9,  right: 11 },\n        { time: \"18:00\", left: 16, right: 24 },\n        { time: \"19:00\", left: 12, right: 18 },\n        { time: \"20:00\", left: 7,  right: 14 },\n        { time: \"21:00\", left: 6,  right: 12 },\n        { time: \"22:00\", left: leftCount, right: rightCount }\n    ];\n} else {\n    hourly[hourly.length - 1].left  = leftCount;\n    hourly[hourly.length - 1].right = rightCount;\n}\nflow.set('hourly_traffic', hourly);\n\nconst lineChartMsg    = { payload: hourly };\nconst resetTriggerMsg = { payload: \"RESET_INTERSECTION\" };\n\nreturn [\n    sqlMsg,\n    uiTableMsg,\n    uiSimMsg,\n    uiLeftCountMsg,\n    uiRightCountMsg,\n    simVisualMsg,\n    lineChartMsg,\n    resetTriggerMsg\n];\n",
    "outputs": 8,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 430,
    "y": 200,
    "wires": [
      [
        "sqlite_save_event"
      ],
      [
        "ui_tbl_history"
      ],
