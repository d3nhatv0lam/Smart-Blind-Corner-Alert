    "name": "Bản Đồ Ngã 3 Top-Down",
    "order": 1,
    "width": "7",
    "height": "8",
    "format": "<template>\n  <div class=\"inter-box\">\n    <svg viewBox=\"0 0 520 340\" class=\"inter-svg\">\n      <!-- Nền đường nhựa tối màu -->\n      <rect width=\"520\" height=\"340\" fill=\"#090e1a\" rx=\"8\"/>\n      \n      <!-- ĐƯỜNG CHÍNH CHẠY NGANG -->\n      <rect x=\"0\" y=\"50\" width=\"520\" height=\"110\" fill=\"#1e293b\"/>\n      <!-- ĐƯỜNG NHÁNH RẼ DỌC TỪ DƯỚI LÊN -->\n      <rect x=\"270\" y=\"160\" width=\"110\" height=\"180\" fill=\"#1e293b\"/>\n\n      <!-- Vạch lề đường xám -->\n      <line x1=\"0\" y1=\"50\" x2=\"520\" y2=\"50\" stroke=\"#475569\" stroke-width=\"3\"/>\n      <line x1=\"0\" y1=\"160\" x2=\"270\" y2=\"160\" stroke=\"#475569\" stroke-width=\"3\"/>\n      <line x1=\"380\" y1=\"160\" x2=\"520\" y2=\"160\" stroke=\"#475569\" stroke-width=\"3\"/>\n      <line x1=\"270\" y1=\"160\" x2=\"270\" y2=\"340\" stroke=\"#475569\" stroke-width=\"3\"/>\n      <line x1=\"380\" y1=\"160\" x2=\"380\" y2=\"340\" stroke=\"#475569\" stroke-width=\"3\"/>\n\n      <!-- VẠCH KẺ ĐƯỜNG MÀU VÀNG ĐỨT ĐOẠN -->\n      <line x1=\"0\" y1=\"105\" x2=\"270\" y2=\"105\" stroke=\"#facc15\" stroke-dasharray=\"12,10\" stroke-width=\"3\"/>\n      <line x1=\"380\" y1=\"105\" x2=\"520\" y2=\"105\" stroke=\"#facc15\" stroke-dasharray=\"12,10\" stroke-width=\"3\"/>\n      <line x1=\"325\" y1=\"160\" x2=\"325\" y2=\"340\" stroke=\"#facc15\" stroke-dasharray=\"12,10\" stroke-width=\"3\"/>\n\n\n      <!-- TÒA NHÀ GÓC KHUẤT (ĐÃ BỎ BẢNG CHỮ, THIẾT KẾ GỌN GÀNG SẠCH ĐẸP) -->\n      <g transform=\"translate(0, 160)\">\n        <!-- Khối bê tông góc tường -->\n        <rect x=\"0\" y=\"0\" width=\"270\" height=\"180\" fill=\"#334155\" stroke=\"#64748b\" stroke-width=\"2.5\"/>\n        <rect x=\"8\" y=\"8\" width=\"254\" height=\"164\" fill=\"#1e293b\" rx=\"4\"/>\n        \n        <!-- Họa tiết vạch chéo kiến trúc nhẹ nhàng -->\n        <pattern id=\"subtleHatch\" width=\"16\" height=\"16\" patternTransform=\"rotate(45 0 0)\" patternUnits=\"userSpaceOnUse\">\n          <line x1=\"0\" y1=\"0\" x2=\"0\" y2=\"16\" stroke=\"#26334d\" stroke-width=\"4\" />\n        </pattern>\n        <rect x=\"16\" y=\"16\" width=\"238\" height=\"148\" fill=\"url(#subtleHatch)\" rx=\"3\"/>\n      </g>\n\n      <!-- Khu đất đối diện bên phải -->\n      <rect x=\"380\" y=\"160\" width=\"140\" height=\"180\" fill=\"#1e293b\" stroke=\"#334155\" stroke-width=\"2\"/>\n\n      <!-- CẢM BIẾN PIR & ĐÈN CẢNH BÁO TẠI GÓC KHUẤT -->\n      <!-- CẢM BIẾN PIR TRÁI (GPIO 18) -->\n      <g transform=\"translate(200, 165)\">\n        <circle cx=\"0\" cy=\"0\" r=\"7\" :fill=\"isLeft ? '#38bdf8' : '#64748b'\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n        <path d=\"M 0 0 L -120 -30 L -120 10 Z\" :fill=\"isLeft ? 'rgba(56, 189, 248, 0.35)' : 'rgba(100, 116, 139, 0.08)'\" :stroke=\"isLeft ? '#38bdf8' : 'transparent'\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n        <text x=\"-40\" y=\"18\" fill=\"#38bdf8\" font-size=\"10\" font-weight=\"bold\">PIR Trái</text>\n      </g>\n\n      <!-- CẢM BIẾN PIR PHẢI (GPIO 16) -->\n      <g transform=\"translate(265, 235)\">\n        <circle cx=\"0\" cy=\"0\" r=\"7\" :fill=\"isRight ? '#38bdf8' : '#64748b'\" stroke=\"#ffffff\" stroke-width=\"2\"/>\n        <path d=\"M 0 0 L 60 75 L 115 75 Z\" :fill=\"isRight ? 'rgba(56, 189, 248, 0.35)' : 'rgba(100, 116, 139, 0.08)'\" :stroke=\"isRight ? '#38bdf8' : 'transparent'\" stroke-width=\"1.5\" stroke-dasharray=\"4,3\"/>\n        <text x=\"-70\" y=\"5\" fill=\"#38bdf8\" font-size=\"10\" font-weight=\"bold\">PIR Phải</text>\n      </g>\n\n      <!-- ĐÈN CẢNH BÁO PHẢI (LED ĐỎ - GPIO 17) -> Hướng về nhánh dưới -->\n      <g transform=\"translate(285, 175)\">\n        <rect x=\"-9\" y=\"-9\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#0f172a\" stroke=\"#475569\" stroke-width=\"1.5\"/>\n        <circle cx=\"0\" cy=\"0\" r=\"6\" :fill=\"isLedRight ? '#ef4444' : '#450a0a'\" :stroke=\"isLedRight ? '#fca5a5' : '#7f1d1d'\" stroke-width=\"2\"/>\n        <circle v-if=\"isLedRight\" cx=\"0\" cy=\"0\" r=\"20\" fill=\"none\" stroke=\"#ef4444\" stroke-width=\"3\" class=\"glow-red\"/>\n        <text x=\"14\" y=\"4\" fill=\"#fca5a5\" font-size=\"11\" font-weight=\"bold\" font-family=\"sans-serif\">{{ isLedRight ? '🔴 BẬT' : '🔴 TẮT' }}</text>\n      </g>\n\n      <!-- ĐÈN CẢNH BÁO TRÁI (LED XANH - GPIO 19) -> Hướng về đường ngang -->\n      <g transform=\"translate(255, 145)\">\n        <rect x=\"-9\" y=\"-9\" width=\"18\" height=\"18\" rx=\"3\" fill=\"#0f172a\" stroke=\"#475569\" stroke-width=\"1.5\"/>\n        <circle cx=\"0\" cy=\"0\" r=\"6\" :fill=\"isLedLeft ? '#22c55e' : '#052e16'\" :stroke=\"isLedLeft ? '#86efac' : '#14532d'\" stroke-width=\"2\"/>\n        <circle v-if=\"isLedLeft\" cx=\"0\" cy=\"0\" r=\"20\" fill=\"none\" stroke=\"#22c55e\" stroke-width=\"3\" class=\"glow-green\"/>\n        <text x=\"5\" y=\"-10\" fill=\"#86efac\" font-size=\"11\" font-weight=\"bold\" font-family=\"sans-serif\">{{ isLedLeft ? '🟢 BẬT' : '🟢 TẮT' }}</text>\n      </g>\n\n      <!-- XE CÔ (SEDAN TOP-DOWN) CHUYỂN ĐỘNG THỰC TẾ -->\n      <g :transform=\"isLeft ? 'translate(130, 115)' : 'translate(35, 115)'\" class=\"vehicle-anim\">\n        <!-- Ánh đèn pha trước xe -->\n        <polygon points=\"50,-8 115,-20 115,20 50,8\" fill=\"url(#hlGradX)\" opacity=\"0.55\"/>\n        <!-- Thân xe ô tô con -->\n        <rect x=\"0\" y=\"-14\" width=\"50\" height=\"28\" rx=\"7\" fill=\"#0284c7\" stroke=\"#38bdf8\" stroke-width=\"2\"/>\n        <!-- Kính xe -->\n        <rect x=\"31\" y=\"-10\" width=\"9\" height=\"20\" rx=\"2\" fill=\"#0f172a\"/>\n        <rect x=\"7\" y=\"-9\" width=\"7\" height=\"18\" rx=\"2\" fill=\"#0f172a\"/>\n        <rect x=\"16\" y=\"-10\" width=\"13\" height=\"20\" fill=\"#0369a1\" rx=\"2\"/>\n        <!-- Đèn pha -->\n        <circle cx=\"50\" cy=\"-9\" r=\"3\" fill=\"#fef08a\"/>\n        <circle cx=\"50\" cy=\"9\" r=\"3\" fill=\"#fef08a\"/>\n        \n      </g>\n\n      <g :transform=\"isRight ? 'translate(353, 205)' : 'translate(353, 280)'\" class=\"vehicle-anim\">\n        <!-- Ánh đèn pha trước xe -->\n        <polygon points=\"-8,0 -20,-65 20,-65 8,0\" fill=\"url(#hlGradY)\" opacity=\"0.55\"/>\n        <!-- Thân xe ô tô con -->\n        <rect x=\"-14\" y=\"0\" width=\"28\" height=\"50\" rx=\"7\" fill=\"#ea580c\" stroke=\"#fb923c\" stroke-width=\"2\"/>\n        <!-- Kính xe -->\n        <rect x=\"-10\" y=\"9\" width=\"20\" height=\"9\" rx=\"2\" fill=\"#0f172a\"/>\n        <rect x=\"-9\" y=\"34\" width=\"18\" height=\"7\" rx=\"2\" fill=\"#0f172a\"/>\n        <rect x=\"-10\" y=\"20\" width=\"20\" height=\"12\" fill=\"#c2410c\" rx=\"2\"/>\n        <!-- Đèn pha -->\n        <circle cx=\"-9\" cy=\"0\" r=\"3\" fill=\"#fef08a\"/>\n        <circle cx=\"9\" cy=\"0\" r=\"3\" fill=\"#fef08a\"/>\n        \n      </g>\n\n      <defs>\n        <linearGradient id=\"hlGradX\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"#fef08a\" stop-opacity=\"0.7\"/>\n          <stop offset=\"100%\" stop-color=\"#fef08a\" stop-opacity=\"0\"/>\n        </linearGradient>\n        <linearGradient id=\"hlGradY\" x1=\"0%\" y1=\"100%\" x2=\"0%\" y2=\"0%\">\n          <stop offset=\"0%\" stop-color=\"#fef08a\" stop-opacity=\"0.7\"/>\n          <stop offset=\"100%\" stop-color=\"#fef08a\" stop-opacity=\"0\"/>\n        </linearGradient>\n      </defs>\n    </svg>\n  </div>\n</template>\n\n<script>\nexport default {\n  data() {\n    return {\n      isLeft: false,\n      isRight: false,\n      isLedLeft: false,\n      isLedRight: false,\n      isCollisionRisk: false\n    }\n  },\n  watch: {\n    msg: function(newVal) {\n      if (newVal && newVal.payload) {\n        const p = newVal.payload;\n        if (typeof p.isLeft !== 'undefined') this.isLeft = p.isLeft;\n        if (typeof p.isRight !== 'undefined') this.isRight = p.isRight;\n        if (typeof p.isLedLeft !== 'undefined') this.isLedLeft = p.isLedLeft;\n        if (typeof p.isLedRight !== 'undefined') this.isLedRight = p.isLedRight;\n        if (typeof p.isCollisionRisk !== 'undefined') this.isCollisionRisk = p.isCollisionRisk;\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n.inter-box {\n  background: #0f172a;\n  border-radius: 10px;\n  padding: 10px;\n  border: 1px solid #334155;\n  box-shadow: 0 4px 20px rgba(0,0,0,0.5);\n}\n.inter-svg {\n  width: 100%;\n  height: auto;\n  border-radius: 6px;\n  background: #090e1a;\n}\n.vehicle-anim {\n  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1);\n}\n.glow-green {\n  animation: greenPulse 0.9s infinite alternate;\n}\n@keyframes greenPulse {\n  from { stroke-opacity: 0.2; r: 8; }\n  to { stroke-opacity: 1; r: 20; }\n}\n.glow-red {\n  animation: redPulse 0.9s infinite alternate;\n}\n@keyframes redPulse {\n  from { stroke-opacity: 0.2; r: 8; }\n  to { stroke-opacity: 1; r: 20; }\n}\n</style>",
    "storeOutMessages": true,
